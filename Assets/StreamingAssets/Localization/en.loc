## ------------------------------------------------------------------ level types (map, HUD, banners)
level.scraps = SCRAPS
level.scraps.desc = Four dense waves with double Scraps drops, and a bonus at the end.
level.equipment = EQUIPMENT
level.equipment.desc = Three waves. Destroy the elite Cache Carrier and grab its cache: a choice of 3 equipment.
level.darkmatter = DARK MATTER
level.darkmatter.desc = Harvest Dark Matter before the wormhole destabilises. Leave whenever you like.
level.repair = REPAIR
level.repair.desc = No enemies. Restore 40% hull, or reinforce for +15 max hull.
level.mystery = MYSTERY
level.mystery.desc = Usually an event: a choice with upsides and downsides. Sometimes a level with bigger rewards, or an ambush.
level.shop = SHOP
level.shop.desc = Buy and upgrade equipment and repair your hull before the boss.
level.boss = BOSS
level.boss.desc = The galaxy guardian. Defeat it to jump to the next galaxy.

