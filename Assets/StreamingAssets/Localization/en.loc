# Project Pathfinder: New Home. English text, and the fallback for every other language.
#
# One "key = value" per line. Lines starting with # are comments. Values are trimmed: wrap a value in double
# quotes to keep leading or trailing spaces. \n is a line break.
# {placeholders} are filled in by the game: keep them, but move them anywhere in the sentence. {seconds:0.0}
# also sets the number format.
# To translate, copy this file to <code>.loc (de.loc, fr.loc...), change @language, and translate the values.
# Missing keys fall back to English. In a development build, F9 reloads the files while the game runs.

@language = English

## ------------------------------------------------------------------ common
common.back = BACK
